# API server origin. iOS simulator: http://127.0.0.1:8080
# Android emulator: http://10.0.2.2:8080
# Physical device: http://<Mac LAN IP>:8080 (same network)
# Copy to .env.local and set this to the server the app should use.
EXPO_PUBLIC_API_URL=

# Optional web-only API origin; native apps continue using EXPO_PUBLIC_API_URL.
# With http://localhost:4000, use http://localhost:8080 for SameSite cookies.
# Add the web page origin to the server's WEB_ORIGINS and restart the server.
EXPO_PUBLIC_WEB_API_URL=

# Naver Cloud Maps Web Dynamic Map Client ID (ncpKeyId), not the client secret.
# Register the exact local/deployed web URL in the Maps application first.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# Optional TMAP Invoke AppKey for mobile web; blank uses Naver web directions.
EXPO_PUBLIC_TMAP_APP_KEY=

# Public runtime values. Leave the DSN empty to keep Sentry disabled.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=

# Build-only values. Store SENTRY_AUTH_TOKEN as a sensitive EAS variable.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
