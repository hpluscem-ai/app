{
  "expo": {
    "name": "hpluseco-app",
    "slug": "hayan100",
    "scheme": "hpluseco",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kr.hayan100.app",
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.hayan100.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#000047",
          "imageWidth": 100
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 요소수 설치 주유소를 찾기 위해 현재 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "영수증 및 계기판 사진을 선택하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "영수증 및 계기판 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "hpluseco",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "086e0093-86eb-4601-abf8-fbebf5fa2cb2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/086e0093-86eb-4601-abf8-fbebf5fa2cb2"
    },
    "owner": "hpluseco"
  }
}
